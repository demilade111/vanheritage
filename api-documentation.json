  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Returns JWT token\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data.token).to.exist;",
                  "    pm.environment.set(\"auth_token\", jsonData.data.token);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"testuser\",\n  \"email\": \"test@example.com\",\n  \"password\": \"Test123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "description": "Register a new user account. Requires username (3+ chars), valid email, and password (6+ chars). Returns JWT token for authentication."
          },
          "response": []
        },
        {
          "name": "Login User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Returns token and user data\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data.token).to.exist;",
                  "    pm.environment.set(\"auth_token\", jsonData.data.token);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"Test123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Login with email and password. Returns JWT token that should be included in Authorization header for protected routes."
          },
          "response": []
        },
        {
          "name": "Get Current User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Returns user data\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data.username).to.exist;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "me"
              ]
            },
            "description": "Get currently authenticated user's information. Requires valid JWT token in Authorization header."
          },
          "response": []
        }
      ],
      "description": "Endpoints for user authentication and authorization using JWT tokens"
    },
    {
      "name": "Heritage Sites",
      "item": [
        {
          "name": "Get All Heritage Sites",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Returns array of sites\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data).to.be.an('array');",
                  "    if (jsonData.data.length > 0) {",
                  "        pm.environment.set(\"site_id\", jsonData.data[0]._id);",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/heritage-sites?withImages=true&neighbourhood=&yearBuilt=",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "heritage-sites"
              ],
              "query": [
                {
                  "key": "withImages",
                  "value": "true",
                  "description": "Filter to only show sites with images (true/false)"
                },
                {
                  "key": "neighbourhood",
                  "value": "",
                  "description": "Filter by neighbourhood name (e.g., 'Downtown', 'Kitsilano')"
                },
                {
                  "key": "yearBuilt",
                  "value": "",
                  "description": "Filter by year built (e.g., 1920)"
                }
              ]
            },
            "description": "Get all heritage sites with optional filters. Returns array of sites with coordinates, names, addresses, and historical information."
          },
          "response": []
        },
        {
          "name": "Get Single Heritage Site",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Returns site and memories\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data.site).to.exist;",
                  "    pm.expect(jsonData.data.memories).to.be.an('array');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/heritage-sites/:siteId",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "heritage-sites",
                ":siteId"
              ],
              "variable": [
                {
                  "key": "siteId",
                  "value": "{{site_id}}",
                  "description": "MongoDB ObjectId of the heritage site"
                }
              ]
            },
            "description": "Get detailed information about a specific heritage site including description, history, architectural style, and all associated memories."
          },
          "response": []
        },
        {
          "name": "Get Site Photo",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 or 404\", function () {",
                  "    pm.expect([200, 404]).to.include(pm.response.code);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/heritage-sites/:siteId/photo",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "heritage-sites",
                ":siteId",
                "photo"
              ],
              "variable": [
                {
                  "key": "siteId",
                  "value": "{{site_id}}",
                  "description": "MongoDB ObjectId of the heritage site"
                }
              ]
            },
            "description": "Get Google Places photo for a heritage site. Returns photo URL if available, otherwise 404."
          },
          "response": []
        },
        {
          "name": "Get Neighbourhoods",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Returns array of neighbourhoods\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data).to.be.an('array');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/heritage-sites/filters/neighbourhoods",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "heritage-sites",
                "filters",
                "neighbourhoods"
              ]
            },
            "description": "Get list of all unique neighbourhoods in Vancouver that contain heritage sites. Used for filtering."
          },
          "response": []
        }
      ],
      "description": "Endpoints for retrieving Vancouver heritage site data including locations, historical information, and filtering"
    },
    {
      "name": "Memories",
      "item": [
        {
          "name": "Create Memory",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Returns created memory\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data._id).to.exist;",
                  "    pm.environment.set(\"memory_id\", jsonData.data._id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"heritageSite\": \"{{site_id}}\",\n  \"title\": \"My childhood memory\",\n  \"story\": \"I remember visiting this beautiful building as a child. The architecture was stunning and it left a lasting impression on me. Every detail was carefully crafted.\",\n  \"imageUrl\": \"https://example.com/my-photo.jpg\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/memories",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "memories"
              ]
            },
            "description": "Create a new memory/story for a heritage site. Requires authentication. Story must be 10-2000 characters. Image is optional."
          },
          "response": []
        },
        {
          "name": "Get User's Memories",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Returns array of memories\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data).to.be.an('array');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/memories/my-memories",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "memories",
                "my-memories"
              ]
            },
            "description": "Get all memories created by the authenticated user. Returns memories with associated heritage site information."
          },
          "response": []
        },
        {
          "name": "Get Site Memories",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/memories/site/:siteId",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "memories",
                "site",
                ":siteId"
              ],
              "variable": [
                {
                  "key": "siteId",
                  "value": "{{site_id}}",
                  "description": "MongoDB ObjectId of the heritage site"
                }
              ]
            },
            "description": "Get all memories for a specific heritage site. Public endpoint, returns memories with user information."
          },
          "response": []
        },
        {
          "name": "Update Memory",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Returns updated memory\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data.story).to.exist;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated memory title\",\n  \"story\": \"Updated story content with more details about my experience at this heritage site. It was truly memorable.\",\n  \"imageUrl\": \"https://example.com/updated-photo.jpg\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/memories/:memoryId",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "memories",
                ":memoryId"
              ],
              "variable": [
                {
                  "key": "memoryId",
                  "value": "{{memory_id}}",
                  "description": "MongoDB ObjectId of the memory"
                }
              ]
            },
            "description": "Update an existing memory. Requires authentication and must be the memory owner. Can update title, story, and imageUrl."
          },
          "response": []
        },
        {
          "name": "Delete Memory",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/memories/:memoryId",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "memories",
                ":memoryId"
              ],
              "variable": [
                {
                  "key": "memoryId",
                  "value": "{{memory_id}}",
                  "description": "MongoDB ObjectId of the memory to delete"
                }
              ]
            },
            "description": "Delete a memory. Requires authentication and must be the memory owner. This action cannot be undone."
          },
          "response": []
        }
      ],
      "description": "Endpoints for managing user memories and stories about heritage sites"
    }
