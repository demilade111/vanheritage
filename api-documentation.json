{
  "info": {
    "_postman_id": "f46363b2-d0e5-4fda-ac21-c41e1ab06af6",
    "name": "Vancouver Heritage API",
    "description": "Complete API for exploring Vancouver heritage sites with user authentication, memories, and admin features",
